# Valores FALSOS. Copie para .env (ignorado pelo Git) e troque os segredos.
# Mantenha este arquivo em sincronia com a tabela do Documento Técnico (seção 14.1).

POSTGRES_DB=vaievolta
POSTGRES_USER=vaievolta
POSTGRES_PASSWORD=troque-esta-senha
# DATABASE_URL é montada pelo Compose:
# postgresql+psycopg://usuario:senha@db:5432/banco

JWT_SECRET=troque-por-um-valor-aleatorio-com-no-minimo-32-caracteres
JWT_EXPIRES_DAYS=15
COOKIE_SECURE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

PROPOSAL_TTL_HOURS=48
ACCOUNT_RETENTION_DAYS=365

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=5
MAX_PHOTOS=5

TZ=America/Sao_Paulo
APP_ENV=dev
LOG_LEVEL=INFO
WEB_PORT=8080
